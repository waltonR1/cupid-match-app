VITE_APP_ENV=production
VITE_API_BASE_URL=https://api.example.com/api

# 公开图片资源基地址：可填后端域名，也可填 CDN 域名。
# 只用于 /profile/** 等公开资源；private://verification/... 认证材料不会走这里。
VITE_ASSET_BASE_URL=https://cdn.example.com
VITE_PUBLIC_CONTACT_EMAIL=contact@rencontreaparis.com
VITE_PUBLIC_PRIVACY_EMAIL=privacy@rencontreaparis.com
VITE_PUBLIC_CONTACT_WECHAT=RencontreParis
VITE_PUBLIC_CONTACT_LOCATION=Paris / France

VITE_API_ENABLE_LOGGING=false
VITE_ENABLE_DEBUG=false
